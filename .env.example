# Copy to .env and fill in. Never commit .env.

# Required to talk to the model. Tests never use it.
ANTHROPIC_API_KEY=

# Model and reasoning effort for customer conversations.
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=low

# Frozen "now" for the agent. The sample orders end in March 2026, so using the
# real date would put every order outside every policy window. Leave empty to
# use the system clock. See ASSUMPTIONS.md.
REFERENCE_DATETIME=2026-03-25T10:00:00

# Folder with the store's CSV files.
DATA_DIR=data
